{
  "everyday-agy": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/Invoke-AntigravityHook.ps1 -Event PreToolUse",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "view_file|read_file|edit_file|replace_file_content|multi_replace_file_content|write_file|write_to_file|create_file|apply_diff|grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/invoke-antigravity-hook.mjs PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|replace_file_content|multi_replace_file_content|write_file|write_to_file|create_file|apply_diff",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/invoke-antigravity-hook.mjs PostToolUse",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
